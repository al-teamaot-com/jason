{
  "schema_version": "1.0",
  "base_branch": "main",
  "control_board_issue": 526,
  "active_overlap_days": 7,
  "required_checks": [
    "cap-001",
    "cap-003",
    "cap-007",
    "system-registry",
    "runtime-service",
    "documentation",
    "repository-hygiene",
    "conversation-experience",
    "teams-gateway"
  ],
  "parallel_development_allowed": true,
  "recommendation_mode": "advisory_only",
  "preproduction": {
    "configured": true,
    "environment_name": "jason-preprod",
    "automatic_deploy": true,
    "kind": "isolated_candidate_container",
    "release_manager": "enabled"
  },
  "production": {
    "serialized_promotion": true,
    "human_approval_required": false,
    "autonomous_repair": {
      "classification_enabled": true,
      "human_approval_required_when_eligible": false,
      "automatic_execution_enabled": true,
      "policy_path": "config/autonomous-repair-release-policy.json",
      "execution_blocker": "none"
    },
    "protected_core_human_approval_required": true,
    "automatic_window": {
      "enabled": true,
      "local_time": "02:30",
      "timezone": "America/New_York",
      "only_production_eligible": true,
      "max_releases_per_window": 1
    }
  },
  "active_display_days": 3,
  "support_autonomy": {
    "enabled": true,
    "owner_approved": true,
    "reconcile_interval_minutes": 5,
    "max_active_items": 2,
    "auto_claim": true,
    "auto_continue_existing_repair_pr": true,
    "auto_fix_repair_owned_ci_failures": true,
    "require_production_acceptance_before_close": true,
    "continue_other_items_when_one_blocked": true,
    "native_repository_implementation_worker": true,
    "reasoning_execution_separation": "runtime_reasoning_plus_bounded_host_worker",
    "host_worker_has_model_credentials": false,
    "runtime_reasoner_has_shell_or_github_credentials": false,
    "playbook_path": "docs/playbooks/Jason-Support-List-Autonomous-Repair.md"
  },
  "integration_automation": {
    "enabled": true,
    "mode": "host_authenticated_native_pr_update",
    "eligibility_marker": "Integration automation: enabled",
    "additional_required_checks": [
      "governed-security-regressions"
    ],
    "reconcile_interval_minutes": 5,
    "max_prs_per_run": 3,
    "production_deployment_separate": true,
    "host_service": "jason-pr-integration-reconciler.service",
    "host_timer": "jason-pr-integration-reconciler.timer",
    "systemd_scope": "user"
  },
  "todo_autonomy": {
    "enabled": true,
    "owner_approved": true,
    "eligibility_statuses": [
      "Planned",
      "In progress"
    ],
    "max_active_items": 1,
    "max_open_todo_issues": 1,
    "intake_worker": "jason-todo-engineering-intake",
    "development_worker": "jason-owner-approved-development-worker",
    "release_manager_required": true,
    "completion_requires_release_state": "closed",
    "completion_requires_production_verified": true,
    "protected_core_requires_exact_owner_approval": true,
    "support_first": true,
    "playbook_path": "docs/playbooks/Jason-Governed-TODO-Engineering-Intake.md"
  }
}
