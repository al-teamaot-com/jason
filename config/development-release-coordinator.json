{
  "schema_version": "1.0",
  "base_branch": "main",
  "control_board_issue": 526,
  "active_overlap_days": 7,
  "required_checks": [
    "cap-001",
    "cap-003",
    "cap-007",
    "system-registry",
    "runtime-service",
    "documentation",
    "repository-hygiene",
    "conversation-experience",
    "teams-gateway"
  ],
  "parallel_development_allowed": true,
  "recommendation_mode": "advisory_only",
  "preproduction": {
    "configured": false,
    "environment_name": "jason-preprod",
    "automatic_deploy": false
  },
  "production": {
    "serialized_promotion": true,
    "human_approval_required": true,
    "autonomous_repair": {
      "classification_enabled": true,
      "human_approval_required_when_eligible": false,
      "automatic_execution_enabled": true,
      "policy_path": "config/autonomous-repair-release-policy.json",
      "execution_blocker": "none"
    }
  },
  "active_display_days": 3,
  "support_autonomy": {
    "enabled": true,
    "owner_approved": true,
    "reconcile_interval_minutes": 5,
    "max_active_items": 2,
    "auto_claim": true,
    "auto_continue_existing_repair_pr": true,
    "auto_fix_repair_owned_ci_failures": true,
    "require_production_acceptance_before_close": true,
    "continue_other_items_when_one_blocked": true,
    "native_repository_implementation_worker": true,
    "reasoning_execution_separation": "runtime_reasoning_plus_bounded_host_worker",
    "host_worker_has_model_credentials": false,
    "runtime_reasoner_has_shell_or_github_credentials": false,
    "playbook_path": "docs/playbooks/Jason-Support-List-Autonomous-Repair.md"
  },
  "integration_automation": {
    "enabled": true,
    "eligibility_marker": "Integration automation: enabled",
    "validation_workflows": [
      "validate.yml",
      "security-regressions.yml",
      "jason-teams-gateway.yml",
      "conversation-experience.yml"
    ],
    "additional_required_checks": [
      "governed-security-regressions"
    ],
    "poll_seconds": 15,
    "timeout_seconds": 1800,
    "max_prs_per_run": 3,
    "max_reconcile_passes": 3,
    "production_deployment_separate": true
  }
}
