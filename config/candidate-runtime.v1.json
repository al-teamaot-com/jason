{
  "schema_version": "1.0",
  "compose_relative_path": "opt/jason/current/infrastructure/jason-runtime/compose.yaml",
  "service": "jason-runtime",
  "candidate_container_name": "jason-runtime-candidate",
  "candidate_image_prefix": "jason-runtime:candidate-",
  "external_networks": [
    "openclaw_default",
    "jason-core",
    "jason-observability"
  ],
  "runtime_health_url": "http://127.0.0.1:18080/healthz",
  "host_health_port": 18080,
  "state_mounts": [
    {
      "source_relative_path": "var/lib/jason/authority",
      "destination": "/var/lib/jason/authority",
      "mode": "rw"
    },
    {
      "source_relative_path": "var/lib/jason/openclaw",
      "destination": "/var/lib/jason/openclaw",
      "mode": "rw"
    },
    {
      "source_relative_path": "var/lib/jason/openclaw/trusted-keys",
      "destination": "/var/lib/jason/openclaw/trusted-keys",
      "mode": "ro"
    }
  ],
  "secret_mounts": [
    {
      "environment_variable": "JASON_OPENBAO_ROLE_ID_HOST_PATH",
      "destination": "/run/jason-secrets/openbao/role_id",
      "mode": "ro"
    },
    {
      "environment_variable": "JASON_OPENBAO_SECRET_ID_HOST_PATH",
      "destination": "/run/jason-secrets/openbao/secret_id",
      "mode": "ro"
    },
    {
      "environment_variable": "JASON_AUTOTASK_OPENBAO_ROLE_ID_HOST_PATH",
      "destination": "/run/jason-secrets/openbao/autotask/role_id",
      "mode": "ro"
    },
    {
      "environment_variable": "JASON_AUTOTASK_OPENBAO_SECRET_ID_HOST_PATH",
      "destination": "/run/jason-secrets/openbao/autotask/secret_id",
      "mode": "ro"
    }
  ]
}
