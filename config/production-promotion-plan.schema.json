{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jason.local/schemas/production-promotion-plan.schema.json",
  "title": "Jason Production Promotion Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "promotion_id",
    "target_environment",
    "current",
    "target",
    "affected_components",
    "configuration_changes",
    "policy_changes",
    "migrations",
    "expected_service_impact",
    "preflight_evidence",
    "verification",
    "rollback",
    "blockers"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "promotion_id": { "type": "string", "minLength": 1 },
    "target_environment": { "const": "production" },
    "current": { "$ref": "#/$defs/deploymentIdentity" },
    "target": { "$ref": "#/$defs/deploymentIdentity" },
    "affected_components": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "configuration_changes": { "type": "array", "items": { "type": "string" } },
    "policy_changes": { "type": "array", "items": { "type": "string" } },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_version", "target_version", "reversible", "backup_required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source_version": { "type": "string", "minLength": 1 },
          "target_version": { "type": "string", "minLength": 1 },
          "reversible": { "type": "boolean" },
          "backup_required": { "type": "boolean" },
          "rollback_method": { "type": ["string", "null"] }
        }
      }
    },
    "expected_service_impact": { "type": "string" },
    "preflight_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "state_restore_required", "method"],
      "properties": {
        "target": { "$ref": "#/$defs/deploymentIdentity" },
        "state_restore_required": { "type": "boolean" },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "deploymentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_version",
        "source_sha",
        "artifact_digest",
        "configuration_revision",
        "policy_revision",
        "playbook_revision",
        "schema_revision"
      ],
      "properties": {
        "release_version": { "type": "string", "minLength": 1 },
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "configuration_revision": { "type": "string", "minLength": 1 },
        "policy_revision": { "type": "string", "minLength": 1 },
        "playbook_revision": { "type": "string", "minLength": 1 },
        "schema_revision": { "type": "string", "minLength": 1 }
      }
    }
  }
}
