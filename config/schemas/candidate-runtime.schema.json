{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jason.local/schemas/candidate-runtime.schema.json",
  "title": "Jason Candidate Runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compose_relative_path",
    "service",
    "candidate_container_name",
    "candidate_image_prefix",
    "external_networks",
    "runtime_health_url"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "compose_relative_path": { "type": "string", "minLength": 1 },
    "service": { "type": "string", "minLength": 1 },
    "candidate_container_name": { "type": "string", "minLength": 1 },
    "candidate_image_prefix": { "type": "string", "minLength": 1 },
    "external_networks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "runtime_health_url": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/healthz$"
    }
  }
}
