{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jason.local/schemas/msp-policy.schema.json",
  "title": "Jason MSP Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "production", "disruption", "autonomy", "ticketing", "client_communications"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit_owner_approval_required"],
      "properties": {
        "explicit_owner_approval_required": { "const": true }
      }
    },
    "disruption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": { "enum": ["approval_required", "denied"] }
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_mode"],
      "properties": {
        "default_mode": { "enum": ["disabled", "approved_playbooks_only"] }
      }
    },
    "ticketing": { "type": "object", "additionalProperties": true },
    "client_communications": { "type": "object", "additionalProperties": true }
  }
}
