{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jason.local/schemas/zero-to-operational-host-plan.schema.json",
  "title": "Jason Zero-to-Operational Host Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "candidate_host_identity",
    "current_release",
    "next_release",
    "msp_configuration",
    "msp_policy",
    "secret_presence_attestation",
    "recovery_recipient_public_key",
    "recovery_signer_private_key",
    "provider_canary",
    "governed_workflow",
    "second_clean_environment_required",
    "production_authorized"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "candidate_host_identity": { "type": "string", "minLength": 1 },
    "current_release": { "$ref": "#/$defs/release" },
    "next_release": { "$ref": "#/$defs/release" },
    "msp_configuration": { "type": "string", "minLength": 1 },
    "msp_policy": { "type": "string", "minLength": 1 },
    "secret_presence_attestation": { "type": "string", "minLength": 1 },
    "recovery_recipient_public_key": { "type": "string", "minLength": 1 },
    "recovery_signer_private_key": { "type": "string", "minLength": 1 },
    "provider_canary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container", "required_providers"],
      "properties": {
        "container": { "type": "string", "minLength": 1 },
        "required_providers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "governed_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "organization_id",
        "mutation_expected"
      ],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "organization_id": { "type": "string", "minLength": 1 },
        "mutation_expected": { "const": false }
      }
    },
    "second_clean_environment_required": { "const": true },
    "production_authorized": { "const": false }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive", "sha256", "source_sha"],
      "properties": {
        "archive": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
