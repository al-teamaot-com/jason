{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jason.local/schemas/candidate-mcp.schema.json",
  "title": "Jason Candidate MCP",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dockerfile_relative_path",
    "candidate_image_prefix",
    "candidate_container_name",
    "host_health_port",
    "health_url",
    "networks"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "dockerfile_relative_path": { "type": "string", "minLength": 1 },
    "candidate_image_prefix": { "type": "string", "minLength": 1 },
    "candidate_container_name": { "type": "string", "minLength": 1 },
    "host_health_port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "health_url": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/healthz$"
    },
    "networks": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
