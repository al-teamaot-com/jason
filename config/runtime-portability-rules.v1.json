{
  "schema_version": "1.0",
  "scan_globs": [
    "infrastructure/jason-runtime/compose.yaml",
    "infrastructure/kfs-collector/compose.yaml",
    "infrastructure/kfs-collector/systemd/*.service",
    "infrastructure/ccc/systemd/*.service",
    "infrastructure/openclaw-operations/systemd/*.service",
    "infrastructure/openclaw-operations/systemd/user/*.service",
    "infrastructure/kfs-collector/*.sh",
    "tools/support_repair_host_worker.py",
    "tools/owner_approved_development_worker.py",
    "tools/pr_integration_source_reconciler.py",
    "tools/autonomous_repair_host_runner.py",
    "tools/documentation_source_reconciler.py",
    "tools/reconcile_production_host_services.sh"
  ],
  "rules": [
    {
      "id": "operator-home-path",
      "severity": "blocker",
      "pattern": "/home/[A-Za-z0-9._-]+/",
      "description": "Runtime artifact depends on an operator home directory."
    },
    {
      "id": "aot-email-domain",
      "severity": "blocker",
      "pattern": "@teamaot\\.com",
      "description": "Runtime artifact contains an AOT-specific email domain."
    },
    {
      "id": "aot-component-label",
      "severity": "blocker",
      "pattern": "AOT Ver [0-9]",
      "description": "Runtime artifact contains an AOT-specific component label."
    },
    {
      "id": "aot-profile-name",
      "severity": "blocker",
      "pattern": "\\baot-[A-Za-z0-9._-]+",
      "description": "Runtime artifact contains an AOT-specific runtime/profile identifier."
    },
    {
      "id": "operator-service-user",
      "severity": "blocker",
      "pattern": "(?:User|Group)=al\\\\b",
      "description": "Service unit is bound to the original operator account."
    },
    {
      "id": "aot-github-repository",
      "severity": "blocker",
      "pattern": "al-teamaot-com/jason",
      "description": "Deployable engineering asset assumes the AOT GitHub repository."
    }
  ]
}
