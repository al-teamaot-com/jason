{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jason.teamaot.local/schemas/cap-001/reasoning-result.schema.json",
  "title": "CAP-001 Reasoning Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "situation_summary", "hypotheses", "recommendation", "confidence", "risk", "evidence_ids", "approval_required"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "case_id": {"type": "string", "minLength": 1},
    "situation_summary": {"type": "string", "minLength": 1},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "statement", "supporting_evidence_ids", "contradicting_evidence_ids", "confidence", "status"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}},
          "contradicting_evidence_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "status": {"enum": ["candidate", "leading", "rejected", "unresolved"]}
        }
      }
    },
    "recommendation": {"type": "string", "minLength": 1},
    "next_evidence_step": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "approval_required": {"type": "boolean"},
    "approval_class": {"type": ["string", "null"]},
    "unresolved_uncertainty": {"type": "array", "items": {"type": "string"}}
  }
}
