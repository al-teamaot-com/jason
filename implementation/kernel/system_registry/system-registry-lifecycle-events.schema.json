{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jason.teamaot.com/schemas/system-registry-lifecycle-events/v1",
  "title": "Jason System Registry Lifecycle Events",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "registry_id",
        "from_lifecycle",
        "to_lifecycle",
        "effective_at",
        "principal_id",
        "authority_references",
        "reason",
        "evidence_references"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,191}$"
        },
        "registry_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
        },
        "from_lifecycle": {
          "enum": ["proposed", "registered", "configured", "verified", "active", "deprecated", "suspended", "retired"]
        },
        "to_lifecycle": {
          "enum": ["proposed", "registered", "configured", "verified", "active", "deprecated", "suspended", "retired"]
        },
        "effective_at": { "type": "string", "format": "date-time" },
        "principal_id": { "type": "string", "minLength": 1 },
        "authority_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verification_method": { "type": "string", "minLength": 1 },
        "verification_outcome": { "enum": ["verified"] }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "to_lifecycle": { "enum": ["verified", "active"] }
            },
            "required": ["to_lifecycle"]
          },
          "then": {
            "required": ["verification_method", "verification_outcome"]
          }
        }
      ]
    }
  }
}
