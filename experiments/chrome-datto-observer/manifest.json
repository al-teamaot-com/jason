{
  "manifest_version": 3,
  "name": "J-Assist - Datto (Gated Development)",
  "version": "0.2.2",
  "key": "",
  "description": "Technician-initiated Datto preview and gated AOT Entra-to-Jason evidence delivery. Uploads require server-attested readiness and separate release.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "clipboardWrite",
    "identity"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://mcp-jason.teamaot.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Open J-Assist",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
