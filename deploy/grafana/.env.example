# Copy to .env and set local values. .env is ignored by Git.

# Pinned deployment baseline. Review deliberately during platform evolution reviews.
GRAFANA_IMAGE=grafana/grafana:13.1.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin

# REQUIRED. Do not commit the real password.
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-local-secret

GRAFANA_SERVER_DOMAIN=localhost
GRAFANA_ROOT_URL=http://localhost:3000
