      "id": 1,
      "options": {
        "content": "## Jason Operations & Configuration\nA curated operator view of **Jason-owned scheduled work and important production configuration**. This intentionally excludes host housekeeping timers, secret values, raw environment variables, and low-value implementation settings. Grafana is observational only and grants no execution authority.",
        "mode": "markdown"
      },
      "title": "Operator View",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "jason-prometheus"
      },
      "description": "Authoritative host systemd timers whose unit names begin with jason-. Next/last run and health are shown in the panels below.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "jason_scheduled_task_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Jason Scheduled Work",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "description": "Purpose",
              "last_result": "Last Result",
              "service": "Service",
              "unit": "Timer"
            }
          }
        }
      ],
      "type": "table"
