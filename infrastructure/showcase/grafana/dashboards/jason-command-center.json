  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Jason Host Up",
      "datasource": {"type": "prometheus", "uid": "jason-prometheus"},
      "targets": [{"expr": "up{job=\"jason-host\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"text": "DOWN"}, "1": {"text": "HEALTHY"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "type": "stat",
      "title": "CPU Usage",
      "datasource": {"type": "prometheus", "uid": "jason-prometheus"},
      "targets": [{"expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{job=\"jason-host\",mode=\"idle\"}[5m])) * 100)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Memory Used",
      "datasource": {"type": "prometheus", "uid": "jason-prometheus"},
      "targets": [{"expr": "(1 - (node_memory_MemAvailable_bytes{job=\"jason-host\"} / node_memory_MemTotal_bytes{job=\"jason-host\"})) * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Root Disk Used",
      "datasource": {"type": "prometheus", "uid": "jason-prometheus"},
      "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{job=\"jason-host\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"jason-host\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Roadmap Completion",
      "datasource": {"type": "prometheus", "uid": "jason-prometheus"},
      "targets": [{"expr": "jason_roadmap_completion_percent", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Milestones Complete",
