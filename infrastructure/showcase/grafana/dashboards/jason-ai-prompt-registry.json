{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "jason-prometheus"
      },
      "description": "Material AI prompts registered for governance and observability. This count excludes test-only and trivial implementation strings.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "jason_ai_prompt_registry_entries",
          "refId": "A"
        }
      ],
      "title": "Registered Material Prompts",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "jason-prometheus"
      },
      "description": "Number of registered prompts whose current source text no longer matches the registered SHA-256 fingerprint.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(jason_ai_prompt_source_hash_match == 0)",
          "refId": "A"
        }
      ],
      "title": "Prompt Source Drift",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "jason-prometheus"
      },
      "description": "Percentage of registered prompts whose source text matches the registered prompt fingerprint.",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * sum(jason_ai_prompt_source_hash_match) / clamp_min(count(jason_ai_prompt_source_hash_match), 1)",
          "refId": "A"
        }
      ],
      "title": "Source Hash Coverage",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "jason-prometheus"
      },
      "description": "1 means every registered prompt has runtime invocation telemetry instrumented. 0 means the registry is visible but per-prompt call/latency/token metrics are not yet fully wired.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "jason_ai_prompt_invocation_telemetry_available",
          "refId": "A"
        }
      ],
      "title": "Invocation Telemetry",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "jason-prometheus"
      },
      "description": "Secret-safe inventory of material AI prompts currently registered in Jason. Full prompt text remains in governed source and is intentionally not exported to Prometheus.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "jason_ai_prompt_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "AI Prompt Registry",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "content_hash": 9,
              "lifecycle": 3,
              "model_profile": 6,
              "name": 1,
              "owner": 12,
              "prompt_id": 0,
              "risk": 5,
              "source_path": 10,
              "source_symbol": 11,
              "structured_output": 7,
              "surface": 4,
              "tool_access": 8,
              "version": 2
            },
            "renameByName": {
              "content_hash": "Content Hash",
              "lifecycle": "Lifecycle",
              "model_profile": "Model Profile",
              "name": "Prompt",
              "owner": "Owner",
              "prompt_id": "Prompt ID",
              "risk": "Risk",
              "source_path": "Source File",
              "source_symbol": "Source Symbol",
              "structured_output": "Structured Output",
              "surface": "Used By / Surface",
              "tool_access": "Tool Access",
              "version": "Version"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "jason-prometheus"
      },
      "description": "Every registered prompt should report 1. A 0 means the source changed, became unreadable, or the registry version/hash was not updated.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "jason_ai_prompt_source_hash_match",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Prompt Source Integrity",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Value": 1,
              "prompt_id": 0
            },
            "renameByName": {
              "Value": "Hash Match",
              "prompt_id": "Prompt ID"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "jason-prometheus"
      },
      "description": "Count of registered material prompts by the runtime surface they influence.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "count by (surface) (jason_ai_prompt_info)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Prompts by Runtime Surface",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Value": 1,
              "surface": 0
            },
            "renameByName": {
              "Value": "Prompts",
              "surface": "Runtime Surface"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "jason",
    "ai",
    "prompts",
    "governance"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Jason AI Prompt Registry",
  "uid": "jason-ai-prompt-registry",
  "version": 1
}
