{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Registered Material Prompts",
      "description": "Material AI prompts registered for governance and observability. This count excludes test-only and trivial implementation strings.",
      "datasource": {"type": "prometheus", "uid": "jason-prometheus"},
      "targets": [{"expr": "jason_ai_prompt_registry_entries", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Prompt Source Drift",
      "description": "Number of registered prompts whose current source text no longer matches the registered SHA-256 fingerprint.",
      "datasource": {"type": "prometheus", "uid": "jason-prometheus"},
      "targets": [{"expr": "sum(jason_ai_prompt_source_hash_match == 0)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Source Hash Coverage",
      "description": "Percentage of registered prompts whose source text matches the registered prompt fingerprint.",
      "datasource": {"type": "prometheus", "uid": "jason-prometheus"},
      "targets": [{"expr": "100 * sum(jason_ai_prompt_source_hash_match) / clamp_min(count(jason_ai_prompt_source_hash_match), 1)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Invocation Telemetry",
      "description": "1 means every registered prompt has runtime invocation telemetry instrumented. 0 means the registry is visible but per-prompt call/latency/token metrics are not yet fully wired.",
      "datasource": {"type": "prometheus", "uid": "jason-prometheus"},
      "targets": [{"expr": "jason_ai_prompt_invocation_telemetry_available", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "type": "table",
      "title": "AI Prompt Registry",
      "description": "Secret-safe inventory of material AI prompts currently registered in Jason. Full prompt text remains in governed source and is intentionally not exported to Prometheus.",
      "datasource": {"type": "prometheus", "uid": "jason-prometheus"},
      "targets": [{"expr": "jason_ai_prompt_info", "format": "table", "instant": true, "refId": "A"}],
      "transformations": [{"id": "organize", "options": {
        "excludeByName": {"Time": true, "Value": true, "__name__": true, "instance": true, "job": true},
        "indexByName": {"prompt_id": 0, "name": 1, "version": 2, "lifecycle": 3, "surface": 4, "risk": 5, "model_profile": 6, "structured_output": 7, "tool_access": 8, "content_hash": 9, "source_path": 10, "source_symbol": 11, "owner": 12},
        "renameByName": {"prompt_id": "Prompt ID", "name": "Prompt", "version": "Version", "lifecycle": "Lifecycle", "surface": "Used By / Surface", "risk": "Risk", "model_profile": "Model Profile", "structured_output": "Structured Output", "tool_access": "Tool Access", "content_hash": "Content Hash", "source_path": "Source File", "source_symbol": "Source Symbol", "owner": "Owner"}
      }}],
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 4},
      "options": {"showHeader": true}
    },
    {
      "type": "table",
      "title": "Prompt Source Integrity",
      "description": "Every registered prompt should report 1. A 0 means the source changed, became unreadable, or the registry version/hash was not updated.",
      "datasource": {"type": "prometheus", "uid": "jason-prometheus"},
      "targets": [{"expr": "jason_ai_prompt_source_hash_match", "format": "table", "instant": true, "refId": "A"}],
      "transformations": [{"id": "organize", "options": {
        "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true},
        "indexByName": {"prompt_id": 0, "Value": 1},
        "renameByName": {"prompt_id": "Prompt ID", "Value": "Hash Match"}
      }}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
      "options": {"showHeader": true}
    },
    {
      "type": "table",
      "title": "Prompts by Runtime Surface",
      "description": "Count of registered material prompts by the runtime surface they influence.",
      "datasource": {"type": "prometheus", "uid": "jason-prometheus"},
      "targets": [{"expr": "count by (surface) (jason_ai_prompt_info)", "format": "table", "instant": true, "refId": "A"}],
      "transformations": [{"id": "organize", "options": {
        "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true},
        "indexByName": {"surface": 0, "Value": 1},
        "renameByName": {"surface": "Runtime Surface", "Value": "Prompts"}
      }}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
      "options": {"showHeader": true}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["jason", "ai", "prompts", "governance"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
