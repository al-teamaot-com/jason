  "panels": [
    {
      "type": "table",
      "title": "Playbook Registry",
      "description": "Registered playbooks and current version/lifecycle. Behavior changes remain versioned governed source changes; Grafana is observational.",
      "datasource": {
        "type": "prometheus",
        "uid": "jason-prometheus"
      },
      "targets": [
        {
          "expr": "jason_playbook_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": false,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "playbook_id": 0,
              "name": 1,
              "version": 2,
              "lifecycle": 3,
              "review_status": 4,
              "Value": 5
            },
            "renameByName": {
              "playbook_id": "ID",
              "name": "Playbook",
              "version": "Version",
              "lifecycle": "Lifecycle",
              "review_status": "Review",
              "Value": "Registered"
            }
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "showHeader": true
      }
    },
