    {
      "type": "row",
      "title": "OpenAI Model / Project / API Key Detail",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "panels": [
        {
          "type": "table",
          "title": "OpenAI Usage by Model / Project / API Key \u2014 24h",
          "datasource": {
            "type": "prometheus",
            "uid": "jason-prometheus"
          },
          "targets": [
            {
              "expr": "jason_openai_org_usage_by_dimension_24h",
              "format": "table",
              "instant": true,
              "refId": "A"
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true,
                  "__name__": true,
                  "instance": true,
                  "job": true,
                  "project_id": true,
                  "api_key_id": true
                },
                "indexByName": {
                  "model": 0,
                  "project": 1,
                  "api_key_name": 2,
                  "usage_type": 3,
                  "Value": 4
                },
                "renameByName": {
                  "model": "Model",
                  "project": "Project",
                  "api_key_name": "API Key",
                  "usage_type": "Metric",
                  "Value": "Value"
                }
              }
            }
          ],
          "gridPos": {
            "h": 12,
            "w": 24,
            "x": 0,
            "y": 13
          },
          "options": {
            "showHeader": true,
            "cellHeight": "sm"
          },
          "description": "Authoritative OpenAI usage grouped by model, project, and API key. Secret values are never exported."
        }
      ]
