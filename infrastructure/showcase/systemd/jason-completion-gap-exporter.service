[Unit]
Description=Jason Completion Gap Metrics Exporter
After=network-online.target
[Service]
Type=simple
User=al
Group=al
Environment=JASON_COMPLETION_GAPS_PATH=/var/lib/jason/openclaw/completion-gaps
Environment=JASON_COMPLETION_GAP_EXPORTER_HOST=0.0.0.0
Environment=JASON_COMPLETION_GAP_EXPORTER_PORT=9474
ExecStart=/usr/bin/python3 /home/al/projects/jason/infrastructure/showcase/completion_gap_exporter.py
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
