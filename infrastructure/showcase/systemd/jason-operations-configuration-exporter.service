[Unit]
Description=Jason Operations & Configuration Metrics Exporter
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=al
Group=al
WorkingDirectory=/opt/jason/current
Environment=JASON_REPO_ROOT=/opt/jason/current
Environment=JASON_OPERATIONS_CONFIGURATION_HOST=0.0.0.0
Environment=JASON_OPERATIONS_CONFIGURATION_PORT=9477
Environment=JASON_RELEASE_MANAGER_RECORDS_DIR=/var/lib/jason/openclaw/release-manager/records
ExecStart=/usr/bin/python3 /opt/jason/current/infrastructure/showcase/operations_configuration_exporter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/jason/current
ReadOnlyPaths=/var/lib/jason/openclaw/release-manager/records
ReadOnlyPaths=-/var/run/docker.sock
ReadOnlyPaths=-/run/docker.sock

[Install]
WantedBy=multi-user.target
