[Unit]
Description=Jason Status Metrics Exporter
After=network-online.target docker.service jason-openclaw-authority-health.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=al
Group=al
WorkingDirectory=/opt/jason/current
Environment=JASON_REPO_ROOT=/opt/jason/current
Environment=JASON_STATUS_HOST=0.0.0.0
Environment=JASON_STATUS_PORT=9464
Environment=JASON_OPENCLAW_AUTHORITY_HEALTH_PATH=/var/lib/jason/openclaw/operational-health.json
ExecStart=/usr/bin/python3 /opt/jason/current/infrastructure/showcase/status_exporter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/jason/current
ReadOnlyPaths=-/var/lib/jason/openclaw/operational-health.json

[Install]
WantedBy=multi-user.target
