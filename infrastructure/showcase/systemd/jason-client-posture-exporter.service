[Unit]
Description=Jason Client Security Posture Prometheus Exporter
After=network.target

[Service]
Type=simple
User=al
WorkingDirectory=/opt/jason/current
Environment=JASON_CLIENT_POSTURE_DIR=/var/lib/jason/client-posture
Environment=JASON_CLIENT_POSTURE_EXPORTER_HOST=0.0.0.0
Environment=JASON_CLIENT_POSTURE_EXPORTER_PORT=9472
ExecStart=/usr/bin/python3 /opt/jason/current/infrastructure/showcase/client_posture_exporter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/jason/current
ReadOnlyPaths=-/var/lib/jason/client-posture

[Install]
WantedBy=multi-user.target
