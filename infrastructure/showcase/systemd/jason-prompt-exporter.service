[Unit]
Description=Jason AI Prompt Registry Exporter
After=network-online.target

[Service]
Type=simple
User=al
Group=al
WorkingDirectory=/home/al/projects/jason
Environment=JASON_REPO_ROOT=/home/al/projects/jason
Environment=JASON_PROMPT_EXPORTER_HOST=0.0.0.0
Environment=JASON_PROMPT_EXPORTER_PORT=9471
ExecStart=/usr/bin/python3 /home/al/projects/jason/infrastructure/showcase/prompt_exporter.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
