[Unit]
Description=Jason Governed Reflection Prometheus Exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=al
Group=al
WorkingDirectory=/opt/jason/observability/current/infrastructure/showcase
Environment=JASON_REFLECTION_DB=/var/lib/jason/openclaw/reflection.sqlite3
Environment=JASON_REFLECTION_EXPORTER_HOST=0.0.0.0
Environment=JASON_REFLECTION_EXPORTER_PORT=9476
ExecStart=/usr/bin/python3 /opt/jason/observability/current/infrastructure/showcase/reflection_exporter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/jason/observability/current /var/lib/jason/openclaw/reflection.sqlite3

[Install]
WantedBy=multi-user.target
