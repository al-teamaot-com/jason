[Unit]
Description=Jason Production Health Metrics Exporter
After=network-online.target docker.service openbao.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=al
Group=al
WorkingDirectory=/home/al/projects/jason
Environment=JASON_REPO_ROOT=/home/al/projects/jason
Environment=JASON_PRODUCTION_HEALTH_HOST=0.0.0.0
Environment=JASON_PRODUCTION_HEALTH_PORT=9467
ExecStart=/usr/bin/python3 /home/al/projects/jason/infrastructure/showcase/production_health_exporter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/al/projects/jason
ReadOnlyPaths=-/var/run/docker.sock
ReadOnlyPaths=-/run/docker.sock
ReadOnlyPaths=-/proc/mounts

[Install]
WantedBy=multi-user.target
