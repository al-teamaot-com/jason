[Unit]
Description=Jason Production Health Metrics Exporter
After=network-online.target docker.service openbao.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=al
Group=al
WorkingDirectory=/opt/jason/current
Environment=JASON_REPO_ROOT=/opt/jason/current
Environment=JASON_PRODUCTION_HEALTH_HOST=0.0.0.0
Environment=JASON_PRODUCTION_HEALTH_PORT=9467
Environment=JASON_EXPECTED_MCP_IMAGE_PREFIX=jason-mcp:
Environment=JASON_EXPECTED_PROVIDER_PROFILE=itglue-autotask-entra-procurement-mail-contract-attachment-resource-catalog-v9
Environment=JASON_EXPECTED_AUTOTASK_REQUESTER_MODE=jason_managed
EnvironmentFile=-/var/lib/jason/production-health.env
ExecStart=/usr/bin/python3 /opt/jason/current/infrastructure/showcase/production_health_exporter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/jason/current
ReadOnlyPaths=-/var/run/docker.sock
ReadOnlyPaths=-/run/docker.sock
ReadOnlyPaths=-/proc/mounts

[Install]
WantedBy=multi-user.target
