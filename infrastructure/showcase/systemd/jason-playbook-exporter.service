[Unit]
Description=Jason Playbook Metrics Exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=al
Group=al
WorkingDirectory=/home/al/projects/jason
Environment=JASON_REPO_ROOT=/home/al/projects/jason
Environment=JASON_PLAYBOOK_EXPORTER_HOST=0.0.0.0
Environment=JASON_PLAYBOOK_EXPORTER_PORT=9468
Environment=JASON_PLAYBOOK_REGISTRY_PATH=/var/lib/jason/playbooks/registry.json
Environment=JASON_PLAYBOOK_EVENTS_PATH=/var/lib/jason/playbooks/events.jsonl
Environment=JASON_PLAYBOOK_RUNS_PATH=/var/lib/jason/playbooks/runs
ExecStart=/usr/bin/python3 /home/al/projects/jason/infrastructure/showcase/playbook_exporter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/al/projects/jason
ReadOnlyPaths=-/var/lib/jason/playbooks

[Install]
WantedBy=multi-user.target
