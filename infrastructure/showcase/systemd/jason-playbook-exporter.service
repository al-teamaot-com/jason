[Unit]
Description=Jason Playbook Metrics Exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=al
Group=al
WorkingDirectory=/opt/jason/current
Environment=JASON_REPO_ROOT=/opt/jason/current
Environment=JASON_PLAYBOOK_EXPORTER_HOST=0.0.0.0
Environment=JASON_PLAYBOOK_EXPORTER_PORT=9468
Environment=JASON_PLAYBOOK_REGISTRY_PATH=/var/lib/jason/playbooks/registry.json
Environment=JASON_PLAYBOOK_EVENTS_PATH=/var/lib/jason/playbooks/events.jsonl
ExecStart=/usr/bin/python3 /opt/jason/current/infrastructure/showcase/playbook_exporter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/jason/current
ReadOnlyPaths=-/var/lib/jason/playbooks

[Install]
WantedBy=multi-user.target
