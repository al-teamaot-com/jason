[Unit]
Description=Jason Security Control Prometheus Exporter
After=network.target

[Service]
Type=simple
User=al
WorkingDirectory=/opt/jason/current
Environment=JASON_ORCHESTRATION_EVENTS_DB=/var/lib/jason/openclaw/orchestration-events.sqlite3
Environment=JASON_SECURITY_CONTROL_EXPORTER_HOST=0.0.0.0
Environment=JASON_SECURITY_CONTROL_EXPORTER_PORT=9471
ExecStart=/usr/bin/python3 /opt/jason/current/infrastructure/showcase/security_control_exporter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/jason/current
ReadOnlyPaths=-/var/lib/jason/openclaw/orchestration-events.sqlite3

[Install]
WantedBy=multi-user.target
