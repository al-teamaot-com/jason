[Unit]
ConditionPathExists=/etc/jason-owner-release/pmv4-e/engineering-manager-system-authorized.json
ConditionPathExists=!/var/lib/jason/openclaw/support-repair/pmv3-engineering-owner-pause.json
Description=Jason autonomous engineering production-window worker
After=network-online.target
Wants=network-online.target

[Service]
User=al
Group=al
ExecCondition=/usr/bin/python3 -I -B /usr/local/lib/jason/pmv4-e-bootstrap/native/tools/pmv4_e_unit_admission.py --mode engineering
ExecCondition=/usr/bin/python3 -I -B /usr/local/lib/jason/pmv4-e-engineering-manager/manager_guard.py --require-system
Type=oneshot
# Retry brief contention; still skip (not fail) if the bounded gate denies.
ExecCondition=/usr/bin/python3 /home/al/.local/lib/jason/pmv3_worker_release_gate.py --retry-contention
# PMV3 permits up to three bounded governed pipeline passes; each pass retains the existing 65-minute process envelope.
TimeoutStartSec=200min
WorkingDirectory=/home/al/.local/lib/jason/engineering-worker-source
Environment=HOME=/home/al
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=JASON_PMV3_INTEGRATION_BATCH_SIZE=3
ExecStart=/usr/bin/python3 /home/al/.local/lib/jason/pmv3_engineering_controller.py --repo /home/al/.local/lib/jason/engineering-worker-source --spool /var/lib/jason/openclaw/support-repair --release-state /var/lib/jason/openclaw/release-manager --max-passes 3 --unchanged-limit 2 --retry-delay 5 --pipeline-timeout 3900 --retry-release-contention
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/al/.local/lib/jason/engineering-worker-source/.git /var/lib/jason/openclaw/autonomous-repair/lifecycle-events /home/al/jason-worktrees/support-repair-closure /home/al/jason-worktrees/support-repair /home/al/jason-worktrees/owner-approved-development /home/al/jason-worktrees/todo-closure /var/lib/jason/openclaw/support-repair /var/lib/jason/openclaw/release-manager
