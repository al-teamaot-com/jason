[Unit]
Description=Run Jason autonomous engineering throughout the approved production window

[Timer]
OnCalendar=Mon..Fri *-*-* 00..04:00/5:00 America/New_York
OnCalendar=Mon..Fri *-*-* 17..23:00/5:00 America/New_York
OnCalendar=Sat,Sun *-*-* *:00/5:00 America/New_York
AccuracySec=15s
Persistent=true
Unit=jason-support-repair-worker.service

[Install]
WantedBy=timers.target
