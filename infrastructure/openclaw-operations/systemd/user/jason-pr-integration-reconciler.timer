[Unit]
Description=Run Jason governed PR integration reconciliation at 7 AM, noon, and 7 PM ET

[Timer]
OnCalendar=*-*-* 07:00:00 America/New_York
OnCalendar=*-*-* 12:00:00 America/New_York
OnCalendar=*-*-* 19:00:00 America/New_York
Persistent=true
Unit=jason-pr-integration-reconciler.service

[Install]
WantedBy=timers.target
