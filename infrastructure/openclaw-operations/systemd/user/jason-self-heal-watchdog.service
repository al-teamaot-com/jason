[Unit]
Description=Jason native full-function self-heal watchdog
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/al/projects/jason
Environment=HOME=/home/al
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/al/.local/lib/jason/jason_self_heal_watchdog.py --root /var/lib/jason/openclaw/self-heal --max-attempts 2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/jason/openclaw/self-heal
