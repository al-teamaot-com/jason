[Unit]
Description=Jason native full-function self-heal watchdog
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/jason/current
EnvironmentFile=-/etc/jason/engineering.env
Environment=HOME=/var/lib/jason/service-home
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/jason/current/tools/jason_self_heal_watchdog.py --root /var/lib/jason/openclaw/self-heal --max-attempts 2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/jason/current
ReadWritePaths=/var/lib/jason/openclaw/self-heal /var/lib/jason/service-home
