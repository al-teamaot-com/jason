[Unit]
Description=Jason 2:30 autonomous engineering window worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/al/projects/jason
Environment=HOME=/home/al
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/al/.local/lib/jason/support_repair_host_worker.py --repo /home/al/projects/jason --spool /var/lib/jason/openclaw/support-repair --max-active 2
ExecStart=/usr/bin/python3 /home/al/.local/lib/jason/owner_approved_development_worker.py --repo /home/al/projects/jason --spool /var/lib/jason/openclaw/support-repair --max-active 2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/al/jason-worktrees/support-repair /home/al/jason-worktrees/owner-approved-development /home/al/projects/jason /var/lib/jason/openclaw/support-repair
