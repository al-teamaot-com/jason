[Unit]
Description=Jason autonomous engineering production-window worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Give the bounded 15-minute per-stage timeout room to log/advance all four stages.
TimeoutStartSec=65min
WorkingDirectory=/home/al/.local/lib/jason/engineering-worker-source
Environment=HOME=/home/al
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/al/.local/lib/jason/pmv3_engineering_controller.py --repo /home/al/.local/lib/jason/engineering-worker-source --spool /var/lib/jason/openclaw/support-repair --release-state /var/lib/jason/openclaw/release-manager --max-passes 4 --unchanged-limit 2 --retry-delay 5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/al/jason-worktrees/support-repair /home/al/jason-worktrees/owner-approved-development /home/al/jason-worktrees/todo-closure /var/lib/jason/openclaw/support-repair /var/lib/jason/openclaw/release-manager
