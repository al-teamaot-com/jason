[Unit]
Description=Jason 2:30 autonomous engineering window worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/lib/jason/source
EnvironmentFile=-/etc/jason/engineering.env
Environment=HOME=/var/lib/jason/service-home
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=GH_CONFIG_DIR=/var/lib/jason/runtime-secrets/github/gh
Environment=JASON_SOURCE_ROOT=/var/lib/jason/source
Environment=JASON_WORKTREE_ROOT=/var/lib/jason/worktrees
Environment=JASON_ENGINEERING_PYTHON=/opt/jason/venv/bin/python
ExecStart=/usr/bin/python3 /opt/jason/current/tools/support_repair_host_worker.py --repo /var/lib/jason/source --spool /var/lib/jason/openclaw/support-repair --max-active 2
ExecStart=/usr/bin/python3 /opt/jason/current/tools/owner_approved_development_worker.py --repo /var/lib/jason/source --spool /var/lib/jason/openclaw/support-repair --max-active 2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/jason/current
ReadWritePaths=/var/lib/jason/source /var/lib/jason/worktrees /var/lib/jason/openclaw/support-repair /var/lib/jason/runtime-secrets/github /var/lib/jason/service-home
