[Unit]
Description=Jason governed PR integration reconciler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/lib/jason/worktrees/pr-integration-main
EnvironmentFile=-/etc/jason/engineering.env
Environment=HOME=/var/lib/jason/service-home
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=GH_CONFIG_DIR=/var/lib/jason/runtime-secrets/github/gh
Environment=JASON_DEVELOPMENT_RELEASE_CONFIG=/opt/jason/current/config/development-release-coordinator.json
ExecStartPre=/usr/bin/git -C /var/lib/jason/worktrees/pr-integration-main fetch origin main
ExecStartPre=/usr/bin/git -C /var/lib/jason/worktrees/pr-integration-main reset --hard origin/main
ExecStart=/usr/bin/python3 /opt/jason/current/tools/pr_integration_source_reconciler.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/jason/current
ReadWritePaths=/var/lib/jason/worktrees/pr-integration-main /var/lib/jason/runtime-secrets/github /var/lib/jason/service-home

[Install]
WantedBy=default.target
