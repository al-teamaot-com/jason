[Unit]
Description=Jason governed autonomous repair deployment runner
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/lib/jason/source
EnvironmentFile=-/etc/jason/engineering.env
Environment=HOME=/var/lib/jason/service-home
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=GH_CONFIG_DIR=/var/lib/jason/runtime-secrets/github/gh
Environment=DOCKER_CONFIG=/var/lib/jason/runtime-secrets/docker
Environment=JASON_SOURCE_ROOT=/var/lib/jason/source
Environment=JASON_WORKTREE_ROOT=/var/lib/jason/worktrees
ExecStart=/usr/bin/python3 /opt/jason/current/tools/autonomous_repair_host_runner.py --repo /var/lib/jason/source --spool /var/lib/jason/openclaw/autonomous-repair
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/jason/current
ReadWritePaths=/var/lib/jason/source /var/lib/jason/worktrees /var/lib/jason/openclaw/autonomous-repair /var/lib/jason/runtime-secrets/docker /var/lib/jason/runtime-secrets/github /var/lib/jason/service-home
