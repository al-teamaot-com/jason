[Unit]
Description=Jason protected release-control readback (root-only)
After=jason-production-drift-watchdog.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/lib/jason/release_control_bridge_worker.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jason/openclaw/release-manager/protected-readback
ReadOnlyPaths=/var/lib/jason/openclaw/release-manager
