[Unit]
Description=Jason post-success documentation reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jason
Group=jason
WorkingDirectory=/opt/jason/current
EnvironmentFile=-/etc/jason/engineering.env
Environment=HOME=/var/lib/jason/service-home
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=GH_CONFIG_DIR=/var/lib/jason/runtime-secrets/github/gh
Environment=JASON_DOCUMENTATION_REPO_ROOT=/var/lib/jason/source
Environment=JASON_DOCUMENTATION_WORKTREE_ROOT=/var/lib/jason/worktrees
ExecStart=/usr/bin/python3 /opt/jason/current/tools/documentation_source_reconciler.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/jason/current
ReadWritePaths=/var/lib/jason/source /var/lib/jason/worktrees /var/lib/jason/runtime-secrets/github /var/lib/jason/service-home

[Install]
WantedBy=multi-user.target
