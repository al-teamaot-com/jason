[Unit]
Description=Jason post-success documentation reconciliation
After=network-online.target
Wants=network-online.target
# One initial attempt plus two bounded retries; no extra controller/timer.
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=oneshot
Restart=on-failure
RestartSec=120s
User=al
Group=al
WorkingDirectory=/opt/jason/current
Environment=HOME=/home/al
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=JASON_DOCUMENTATION_REPO_ROOT=/home/al/.local/lib/jason/documentation-source-repo
ExecStart=/usr/bin/python3 /opt/jason/current/tools/documentation_source_reconciler.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/al/jason-worktrees /home/al/.local/lib/jason -/srv/jason/archive/engineering-worktrees/documentation-reconciliation
ReadOnlyPaths=/opt/jason/current

[Install]
WantedBy=multi-user.target
