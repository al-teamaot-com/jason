[Unit]
Description=Jason post-success documentation reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=al
Group=al
WorkingDirectory=/opt/jason/current
Environment=HOME=/home/al
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=JASON_DOCUMENTATION_REPO_ROOT=/home/al/projects/jason
ExecStart=/usr/bin/python3 /opt/jason/current/tools/documentation_source_reconciler.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/al/jason-worktrees /home/al/projects/jason
ReadOnlyPaths=/opt/jason/current

[Install]
WantedBy=multi-user.target
