[Unit]
Description=Jason root-governed exact catalog rollback recovery (disabled until Owner deployment approval)
After=docker.service jason-core.service
Requires=docker.service
ConditionPathExists=/etc/jason-owner-release/catalog-scoped-promotion-installed.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/lib/jason/catalog-scoped-promotion/tools/catalog_scoped_promotion_recovery.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/jason-catalog-scoped-promotion /var/lib/jason/openclaw/release-manager /var/run/docker.sock
ReadOnlyPaths=/opt/jason /usr/local/lib/jason /etc/jason-owner-release
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
