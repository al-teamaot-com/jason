[Unit]
Description=Jason governed PR integration reconciler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=al
Group=al
WorkingDirectory=/home/al/jason-worktrees/pr-integration-main
Environment=HOME=/home/al
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=JASON_REPOSITORY=al-teamaot-com/jason
Environment=JASON_DEVELOPMENT_RELEASE_CONFIG=/home/al/jason-worktrees/pr-integration-main/config/development-release-coordinator.json
ExecStartPre=/usr/bin/git -C /home/al/jason-worktrees/pr-integration-main fetch origin main
ExecStartPre=/usr/bin/git -C /home/al/jason-worktrees/pr-integration-main reset --hard origin/main
ExecStart=/usr/bin/python3 /home/al/jason-worktrees/pr-integration-main/tools/pr_integration_source_reconciler.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/al/jason-worktrees /home/al/projects/jason

[Install]
WantedBy=multi-user.target
