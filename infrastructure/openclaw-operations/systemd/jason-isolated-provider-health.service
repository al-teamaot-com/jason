[Unit]
Description=Jason isolated provider-health read-only shadow (advisory only)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/jason/current/tools/isolated_service_shadow.py
ConditionPathExists=/opt/jason/current/config/isolated-services.json
ConditionPathExists=/var/lib/jason/provider-health-canaries.json

[Service]
Type=oneshot
User=al
Group=al
WorkingDirectory=/opt/jason/current
StateDirectory=jason-isolated-services
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=120
ExecStart=/usr/bin/python3 /opt/jason/current/tools/isolated_service_shadow.py --service provider_health_monitor --repo /opt/jason/current --state-root /var/lib/jason-isolated-services --provider-source /var/lib/jason/provider-health-canaries.json

# Installed only as DISABLED/DORMANT by the native release installer.
# No provider contacts/writes and no PMV3 production authority.
