[Unit]
Description=Jason root-owned host release reconciliation worker
After=docker.service
ConditionPathExists=/usr/local/lib/jason/release_host_reconcile_worker.py

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/lib/jason/release_host_reconcile_worker.py
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
# Must exceed the root worker's bounded 360s candidate-script timeout plus
# Git validation/result publication overhead; otherwise systemd terminates the
# worker before it can emit the fail-closed result or remove the request.
TimeoutStartSec=4500
