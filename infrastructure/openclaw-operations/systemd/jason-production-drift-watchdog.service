[Unit]
Description=Jason Production Desired-State Drift Watchdog
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Exit 2 = drift DETECTED and protected breaker evidence recorded, not a
# watchdog execution error. Other nonzero exits remain failed system units.
# Without this, detecting a real violation marks the watchdog itself failed,
# creating an artificial, self-reinforcing drift incident.
SuccessExitStatus=2
ExecStart=/usr/bin/python3 /opt/jason/current/tools/production_drift_watchdog.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/jason/current
ReadOnlyPaths=-/run/docker.sock
ReadOnlyPaths=-/var/run/docker.sock
ReadWritePaths=/var/lib/jason/openclaw/release-manager
