[Unit]
Description=Jason independent governed engineering lane (supervisor)
After=network-online.target
Wants=network-online.target
# The wrapper independently verifies the legacy service is inactive and its timer is disabled/masked before any replacement lane runs.
ConditionPathExists=/home/al/.local/lib/jason/pmv3_worker_release_gate.py
ConditionPathExists=/home/al/.local/lib/jason/independent_governed_lane.py
ConditionPathExists=/home/al/.local/lib/jason/engineering_supervisor.py

[Service]
Type=oneshot
User=al
Group=al
WorkingDirectory=/home/al/.local/lib/jason/engineering-source-repo
Environment=HOME=/home/al
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecCondition=/usr/bin/python3 /home/al/.local/lib/jason/pmv3_worker_release_gate.py
ExecStart=/usr/bin/python3 /home/al/.local/lib/jason/independent_governed_lane.py --lane supervisor --repo /home/al/.local/lib/jason/engineering-source-repo --spool /var/lib/jason/openclaw/support-repair
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/al/jason-worktrees/support-repair /home/al/jason-worktrees/owner-approved-development /home/al/jason-worktrees/todo-closure /var/lib/jason/openclaw/support-repair

# SOURCE ONLY: install/enable only through an exact-SHA governed PMV3 release.
