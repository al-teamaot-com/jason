[Unit]
Description=Jason root-owned host release reconciliation worker
After=docker.service
ConditionPathExists=/opt/jason/pmv4-e-trusted/tools/release_host_reconcile_worker.py

[Service]
ExecCondition=/usr/bin/python3 -I -B /opt/jason/pmv4-e-trusted/tools/pmv4_e_unit_admission.py --mode component-reconcile
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /opt/jason/pmv4-e-trusted/tools/release_host_reconcile_worker.py
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
# Must exceed the root worker's bounded 360s candidate-script timeout plus
# Git validation/result publication overhead; otherwise systemd terminates the
# worker before it can emit the fail-closed result or remove the request.
TimeoutStartSec=4500
