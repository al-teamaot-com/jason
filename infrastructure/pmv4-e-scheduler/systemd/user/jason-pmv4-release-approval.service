[Unit]
Description=Jason Owner Teams release approval offers only while automatic promotion is held
After=docker.service
ConditionPathExists=/var/lib/jason/openclaw/release-manager/auto-promotion-incident-hold
ConditionPathExists=/home/al/.local/lib/jason/release_manager_host_runner.py

[Service]
ExecCondition=/usr/bin/python3 -I -B /usr/local/lib/jason/pmv4-e-bootstrap/native/tools/pmv4_e_unit_admission.py --mode release-approval
Type=oneshot
# Separate read/approval-only command; never initiate deployment.
ExecStart=/usr/bin/python3 /home/al/.local/lib/jason/release_manager_host_runner.py --repo /home/al/.local/lib/jason/release-approval-source --state-root /var/lib/jason/openclaw/release-manager approval-only-held
WorkingDirectory=/home/al/.local/lib/jason/release-approval-source
Environment=PYTHONUNBUFFERED=1
