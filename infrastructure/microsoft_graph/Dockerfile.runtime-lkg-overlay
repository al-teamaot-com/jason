# Source-isolated AOT Entra group management preproduction candidate.
# Reuses EXACT running LKG runtime image, not moving registry tags.
ARG BASE_IMAGE=jason-runtime:release-d1b8c196dadd-bb7d28ebd5e5
FROM ${BASE_IMAGE}
USER root
COPY --chown=0:1000 implementation/ /app/implementation/
COPY --chown=0:1000 config/ /app/config/
RUN chmod -R go-w,g+rX /app/implementation /app/config
ARG CANDIDATE_SHA
LABEL org.opencontainers.image.revision=${CANDIDATE_SHA}
USER 1000:1000
