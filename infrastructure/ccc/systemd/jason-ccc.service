[Unit]
Description=Jason Constitutional and Compliance Check (CCC)
After=network-online.target docker.service jason-openclaw-authority-health.service
Wants=network-online.target
ConditionPathExists=/var/lib/jason/ccc/ccc.json
ConditionPathExists=/var/lib/jason/authority/authority.sqlite3

[Service]
Type=oneshot
User=jason
Group=jason
WorkingDirectory=/opt/jason/ccc-current
Environment=DOCKER_CONFIG=/var/lib/jason/runtime-secrets/docker
ExecStart=/usr/bin/python3 /opt/jason/ccc-current/tools/run_ccc.py --config /var/lib/jason/ccc/ccc.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/jason/ccc-current /var/lib/jason/source /var/lib/jason/authority /var/lib/jason/openclaw
ReadWritePaths=/var/lib/jason/source/.git /var/lib/jason/ccc /var/lib/jason/evidence/ccc /var/lib/jason/recovery/ccc /var/lib/jason/runtime-secrets/docker
UMask=0077
TimeoutStartSec=45min
