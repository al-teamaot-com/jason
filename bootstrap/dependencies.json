{
  "schema_version": "0.1",
  "dependencies": [
    {
      "name": "python",
      "required": true,
      "minimum_version": "3.12",
      "check_command": "python3 --version",
      "install_policy": "explicit"
    },
    {
      "name": "docker",
      "required": true,
      "minimum_version": "24.0",
      "check_command": "docker --version",
      "install_policy": "explicit"
    },
    {
      "name": "docker-compose-plugin",
      "required": true,
      "minimum_version": "2.20",
      "check_command": "docker compose version",
      "install_policy": "explicit"
    },
    {
      "name": "openbao",
      "required": true,
      "deployment": "container",
      "image": "ghcr.io/openbao/openbao:2.6",
      "install_policy": "managed_container"
    }
  ]
}
