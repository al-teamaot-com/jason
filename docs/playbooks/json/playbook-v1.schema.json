{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamaot.com/jason/schemas/playbook-v1.json",
  "title": "Jason JSON Playbook v1",
  "type": "object",
  "required": ["schema_version", "playbook", "state_model", "steps", "verification", "completion", "autonomy"],
  "properties": {
    "schema_version": {"const": 1},
    "playbook": {
      "type": "object",
      "required": ["id", "name", "version", "lifecycle", "target_type"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"},
        "lifecycle": {"enum": ["draft", "pilot", "production"]},
        "target_type": {"enum": ["ticket", "endpoint", "user", "site", "service", "provider_object"]}
      },
      "additionalProperties": true
    },
    "state_model": {"type": "object", "required": ["entry_step"]},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["diagnostic", "decision", "remediation", "verification", "wait", "document", "human_review", "complete", "escalate"]},
          "capability": {"type": "string"},
          "arguments": {"type": "object"},
          "approval_classification": {"enum": ["read_only", "non_destructive", "modifying", "disruptive"]},
          "approval_required": {"type": "boolean"},
          "next": {"type": "string"},
          "verification_step": {"type": "string"},
          "resume": {"type": "string"},
          "seconds": {"type": "integer", "minimum": 60, "maximum": 2592000},
          "wake_on": {"type": "string"}
        },
        "not": {"anyOf": [
          {"required": ["shell"]},
          {"required": ["bash"]},
          {"required": ["powershell"]},
          {"required": ["script"]},
          {"required": ["raw_command"]},
          {"required": ["provider_url"]},
          {"required": ["direct_provider_access"]}
        ]},
        "additionalProperties": true
      }
    },
    "verification": {"type": "object", "required": ["authoritative_source", "success_condition"]},
    "completion": {"type": "object", "required": ["terminal_disposition"]},
    "autonomy": {
      "type": "object",
      "required": ["activation", "allowed_capabilities"],
      "properties": {
        "activation": {"enum": ["disabled", "shadow", "autonomous", "suspended"]},
        "allowed_capabilities": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": true
}