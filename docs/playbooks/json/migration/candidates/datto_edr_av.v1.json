{
  "autonomy": {
    "activation": "shadow",
    "allowed_capabilities": [
      "automation.component.execute",
      "automation.job.output.read",
      "automation.job.read",
      "endpoint.device.read",
      "endpoint.security.detection.search",
      "endpoint.security.status.read",
      "service.ticket.note.create",
      "service.ticket.notes.search",
      "service.ticket.read",
      "service.ticket.update"
    ],
    "approval_bound_branches": [
      "run_component",
      "note",
      "complete_ticket"
    ],
    "disruptive_branches": []
  },
  "completion": {
    "terminal_disposition": "verified healthy and security-resolved or human review; no reboot/clean uninstall without separate exact permission"
  },
  "expected_state": {
    "authoritative_product_health": "Healthy",
    "security_resolution_when_triggered": "independently clean and recurrence verified",
    "no_dup_component_execution": true,
    "overnight_reboot_time": "02:30",
    "post_reboot_verification_time": "03:30",
    "unattended_reboot_forbidden": true
  },
  "migration": {
    "source_conversion": "legacy_python_pure_state_machine_reuse_and_source_only_json_orchestration_candidate",
    "legacy_source_blob_sha": "c3645b2c003e6f4079b62d32572e27b00cdd57b9",
    "legacy_registry_version": "1.3.0",
    "source_map": "docs/playbooks/json/migration/source_maps/datto_edr_av.source-map.json",
    "missing_or_unimplemented_parity": [
      "Normal Python PlaybookRun persisted state and step-specific job identity not yet wired to canonical JSON interpreter",
      "Existing Python security threat classifier, clean-scan/detection/recurrence requirements need end-to-end JSON evidence normalization and approval integration",
      "Governed AV Force Update predefined command and recovery clean uninstall policy-gated branches are not executable by approved JSON capabilities",
      "02:30 scheduled reboot/03:30 verification remain separately exact Owner-approved and MUST NOT be auto-dispatched",
      "Job reconciliation, protected source/JSON takeover, Autotask ticket notes and provider-connected preproduction acceptance not done"
    ],
    "accepted_for_execution": false,
    "production_activation_authorized": false
  },
  "playbook": {
    "id": "datto_edr_av",
    "lifecycle": "pilot",
    "name": "Jason - Datto EDR/AV Diagnose & Repair",
    "owner": "AOT",
    "source": "implementation/autonomous_remediation/datto_edr_av_playbook.py",
    "target_type": "endpoint",
    "version": "1.3.0-migration.2"
  },
  "schema_version": 1,
  "scope": {
    "direct_provider_access": false,
    "no_disruptive_reboot_without_exact_owner_grant": true,
    "clean_uninstall_review_bound": true,
    "no_provider_write_from_json_without_existing_orchestrator": true,
    "source_only": true
  },
  "state_model": {
    "entry_step": "read_endpoint",
    "persist": [
      "run_id",
      "ticket_id",
      "device_uid",
      "client_id",
      "source_version",
      "last_health_fingerprint",
      "security_trigger",
      "attempted_steps",
      "provider_job_ids",
      "completed_job_keys",
      "last_security",
      "recurrence_verified",
      "scheduled_reboot_used",
      "recovery_reboot_used",
      "next_due_at"
    ],
    "state_machine": "existing datto_edr_av_playbook.PlaybookRun and next_action",
    "do_not_dispatch_duplicate_component_or_reboot": true
  },
  "steps": [
    {
      "id": "read_endpoint",
      "type": "diagnostic",
      "capability": "endpoint.device.read",
      "arguments": {
        "resource_id": {
          "$fact": "device_uid"
        }
      },
      "next": "identity_gate"
    },
    {
      "id": "identity_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_client_device_and_ticket_scope_verified",
            "operator": "eq",
            "value": true
          },
          "next": "read_status"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "read_status",
      "type": "diagnostic",
      "capability": "endpoint.security.status.read",
      "arguments": {
        "resource_id": {
          "$fact": "device_uid"
        }
      },
      "next": "read_detections"
    },
    {
      "id": "read_detections",
      "type": "diagnostic",
      "capability": "endpoint.security.detection.search",
      "arguments": {
        "resource_id": {
          "$fact": "device_uid"
        }
      },
      "next": "classify"
    },
    {
      "id": "classify",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "source_planned_disposition",
            "operator": "eq",
            "value": "source_health_and_security_verified"
          },
          "next": "final_health_gate"
        },
        {
          "when": {
            "fact": "source_planned_disposition",
            "operator": "eq",
            "value": "approved_component_candidate"
          },
          "next": "component_grant_gate"
        },
        {
          "when": {
            "fact": "source_planned_disposition",
            "operator": "eq",
            "value": "awaiting_evidence_or_human_review"
          },
          "next": "waiting_review"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "component_grant_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_standing_safe_component_identity_and_owner_promotion",
            "operator": "eq",
            "value": true
          },
          "next": "run_component"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "run_component",
      "type": "remediation",
      "capability": "automation.component.execute",
      "arguments": {
        "$fact": "trusted_exact_component_dispatch_arguments"
      },
      "approval_classification": "modifying",
      "approval_required": true,
      "retry": {
        "max_attempts": 1
      },
      "verification_step": "read_job"
    },
    {
      "id": "read_job",
      "type": "verification",
      "capability": "automation.job.read",
      "arguments": {
        "$fact": "trusted_exact_existing_job_read_arguments"
      },
      "next": "job_gate"
    },
    {
      "id": "job_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "same_device_exact_job_terminal_and_not_duplicate",
            "operator": "eq",
            "value": true
          },
          "next": "read_output"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "read_output",
      "type": "verification",
      "capability": "automation.job.output.read",
      "arguments": {
        "$fact": "trusted_exact_job_output_arguments"
      },
      "next": "output_gate"
    },
    {
      "id": "output_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_job_stdout_and_evidence_verified",
            "operator": "eq",
            "value": true
          },
          "next": "read_final_health"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "read_final_health",
      "type": "verification",
      "capability": "endpoint.security.status.read",
      "arguments": {
        "resource_id": {
          "$fact": "device_uid"
        }
      },
      "next": "final_health_gate"
    },
    {
      "id": "final_health_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "independent_source_health_security_scan_and_recurrence_completed",
            "operator": "eq",
            "value": true
          },
          "next": "note_gate"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "note_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_internal_summary_and_owner_promotion",
            "operator": "eq",
            "value": true
          },
          "next": "note"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "note",
      "type": "remediation",
      "capability": "service.ticket.note.create",
      "arguments": {
        "$fact": "trusted_exact_internal_note_arguments"
      },
      "approval_classification": "modifying",
      "approval_required": true,
      "retry": {
        "max_attempts": 1
      },
      "verification_step": "verify_note"
    },
    {
      "id": "verify_note",
      "type": "verification",
      "capability": "service.ticket.notes.search",
      "arguments": {
        "ticket_id": {
          "$fact": "ticket_id"
        }
      },
      "next": "note_readback_gate"
    },
    {
      "id": "note_readback_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_jason_internal_note_readback",
            "operator": "eq",
            "value": true
          },
          "next": "complete_ticket"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "complete_ticket",
      "type": "remediation",
      "capability": "service.ticket.update",
      "arguments": {
        "$fact": "trusted_exact_ticket_complete_arguments"
      },
      "approval_classification": "modifying",
      "approval_required": true,
      "retry": {
        "max_attempts": 1
      },
      "verification_step": "verify_ticket"
    },
    {
      "id": "verify_ticket",
      "type": "verification",
      "capability": "service.ticket.read",
      "arguments": {
        "ticket_id": {
          "$fact": "ticket_id"
        }
      },
      "next": "ticket_gate"
    },
    {
      "id": "ticket_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_ticket_completed_readback",
            "operator": "eq",
            "value": true
          },
          "next": "complete"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "waiting_review",
      "type": "wait",
      "seconds": 900,
      "resume": "human_review"
    },
    {
      "id": "human_review",
      "type": "human_review"
    },
    {
      "id": "complete",
      "type": "complete"
    }
  ],
  "trigger": {
    "provider": "Datto RMM/EDR/AV",
    "exact_endpoint_and_ticket": true,
    "health_and_security_trigger_distinct": true,
    "security_scan_approval_not_inferred_from_product_health": true
  },
  "verification": {
    "authoritative_source": "existing Datto EDR/AV normalized health and security posture, exact job/status/output and Autotask internal note/ticket readback",
    "success_condition": "healthy product and independently resolved security; relevant scan clean, recurrence verified, no duplicate component or unauthorized reboot"
  }
}
