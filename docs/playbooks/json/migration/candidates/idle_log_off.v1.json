{
  "autonomy": {
    "activation": "shadow",
    "allowed_capabilities": [
      "automation.component.execute",
      "automation.job.output.read",
      "automation.job.read",
      "endpoint.device.read",
      "management.alert.search",
      "service.ticket.note.create",
      "service.ticket.notes.search",
      "service.ticket.read",
      "service.ticket.update"
    ],
    "approval_bound_branches": [
      "run_setter",
      "write_note",
      "complete_ticket"
    ],
    "disruptive_branches": []
  },
  "completion": {
    "terminal_disposition": "verified compliant current monitor, exact internal note and ticket status, or Human Review; no direct forced logoff"
  },
  "expected_state": {
    "compliant_monitor": true,
    "current_original_alert_cleared": true,
    "one_setter_attempt_max": 1,
    "setter_component_uid": "acc6a240-881d-4655-9470-87f60c8e35e8"
  },
  "migration": {
    "source_conversion": "source_specific_partial_candidate_not_accepted",
    "legacy_source_blob_sha": "ef5b3e7b437a268a351370398f6417ff607d1c0b",
    "legacy_registry_version": "1.1.0",
    "source_map": "docs/playbooks/json/migration/source_maps/idle_log_off.source-map.json",
    "missing_or_unimplemented_parity": [
      "Source original registry does NOT authorize endpoint.alert.resolve, despite authored document; exact separate approved grant/source amendment needed",
      "Exact current client/site required idle duration, component version and variables must be bound through live governed site policy and Owner promotion",
      "Monitor provider output/UID/cadence and setter job/error response must be fully parsed into trusted JSON source facts",
      "One setter lifecycle, existing job polling, monitor normal 15-minute refresh and exact completion readback require end-to-end isolated acceptance",
      "No provider-connected preproduction or live confirmation of same client/role/CI and no production dispatcher selection tested"
    ],
    "accepted_for_execution": false,
    "production_activation_authorized": false
  },
  "playbook": {
    "id": "idle_log_off",
    "lifecycle": "pilot",
    "name": "Jason - Windows Idle Log Off Compliance / Repair",
    "owner": "AOT",
    "source": "docs/playbooks/Jason-Windows-Idle-Log-Off-Compliance-Repair.md",
    "target_type": "endpoint",
    "version": "1.1.0-migration.2"
  },
  "schema_version": 1,
  "scope": {
    "direct_provider_access": false,
    "source_only": true,
    "no_forced_logoff": true,
    "no_reboot": true,
    "no_servers_kiosks_shared_sessions": true,
    "no_alert_resolution_without_new_source_authority": true,
    "no_direct_PowerShell": true
  },
  "state_model": {
    "entry_step": "read_ticket",
    "persist": [
      "ticket_id",
      "client_id",
      "device_uid",
      "alert_uid",
      "site_policy_sha",
      "monitor_uid",
      "setter_component_uid",
      "setter_job_uid",
      "setter_attempted",
      "last_stdout_sha",
      "last_stderr_sha",
      "next_due_at"
    ],
    "grace_seconds": 900,
    "no_replay_after_uncertain_setter": true
  },
  "steps": [
    {
      "id": "read_ticket",
      "type": "diagnostic",
      "capability": "service.ticket.read",
      "arguments": {
        "ticket_id": {
          "$fact": "target_id"
        }
      },
      "next": "ticket_gate"
    },
    {
      "id": "ticket_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_ticket_client_and_CI_identity",
            "operator": "eq",
            "value": true
          },
          "next": "read_endpoint"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "read_endpoint",
      "type": "diagnostic",
      "capability": "endpoint.device.read",
      "arguments": {
        "resource_id": {
          "$fact": "device_uid"
        }
      },
      "next": "endpoint_gate"
    },
    {
      "id": "endpoint_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "workstation_applicability_and_client_policy_verified",
            "operator": "eq",
            "value": true
          },
          "next": "read_alert"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "read_alert",
      "type": "diagnostic",
      "capability": "management.alert.search",
      "arguments": {
        "status": "open"
      },
      "next": "monitor_gate"
    },
    {
      "id": "monitor_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "verified_idle_logoff_disposition",
            "operator": "eq",
            "value": "exact_setter_candidate_needs_governed_approval"
          },
          "next": "setter_gate"
        },
        {
          "when": {
            "fact": "verified_idle_logoff_disposition",
            "operator": "eq",
            "value": "waiting_normal_monitor_clear"
          },
          "next": "wait_monitor"
        },
        {
          "when": {
            "fact": "verified_idle_logoff_disposition",
            "operator": "eq",
            "value": "monitor_cleared_verify_ticket"
          },
          "next": "note_gate"
        },
        {
          "when": {
            "fact": "verified_idle_logoff_disposition",
            "operator": "eq",
            "value": "no_current_alert_verify_compliance"
          },
          "next": "human_review"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "setter_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_policy_setter_component_variables_owner_grant_one_attempt",
            "operator": "eq",
            "value": true
          },
          "next": "run_setter"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "run_setter",
      "type": "remediation",
      "capability": "automation.component.execute",
      "arguments": {
        "$fact": "trusted_exact_idle_setter_job_args"
      },
      "approval_classification": "modifying",
      "approval_required": true,
      "retry": {
        "max_attempts": 1
      },
      "verification_step": "read_job"
    },
    {
      "id": "read_job",
      "type": "verification",
      "capability": "automation.job.read",
      "arguments": {
        "$fact": "trusted_existing_setter_job_read_args"
      },
      "next": "job_gate"
    },
    {
      "id": "job_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_job_terminal_same_device_no_duplicate",
            "operator": "eq",
            "value": true
          },
          "next": "read_stdout"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "read_stdout",
      "type": "verification",
      "capability": "automation.job.output.read",
      "arguments": {
        "$fact": "trusted_existing_setter_output_args"
      },
      "next": "output_gate"
    },
    {
      "id": "output_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_setter_stdout_success_and_stderr_empty",
            "operator": "eq",
            "value": true
          },
          "next": "read_monitor_after"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "read_monitor_after",
      "type": "verification",
      "capability": "management.alert.search",
      "arguments": {
        "status": "open"
      },
      "next": "monitor_after_gate"
    },
    {
      "id": "monitor_after_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_idle_monitor_cleared_and_compliance_verified",
            "operator": "eq",
            "value": true
          },
          "next": "note_gate"
        }
      ],
      "default": "wait_monitor"
    },
    {
      "id": "note_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_jason_internal_note_and_promotion",
            "operator": "eq",
            "value": true
          },
          "next": "write_note"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "write_note",
      "type": "remediation",
      "capability": "service.ticket.note.create",
      "arguments": {
        "$fact": "trusted_exact_idle_note_args"
      },
      "approval_classification": "modifying",
      "approval_required": true,
      "retry": {
        "max_attempts": 1
      },
      "verification_step": "verify_note"
    },
    {
      "id": "verify_note",
      "type": "verification",
      "capability": "service.ticket.notes.search",
      "arguments": {
        "ticket_id": {
          "$fact": "target_id"
        }
      },
      "next": "note_readback_gate"
    },
    {
      "id": "note_readback_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_internal_note_provider_readback",
            "operator": "eq",
            "value": true
          },
          "next": "complete_ticket"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "complete_ticket",
      "type": "remediation",
      "capability": "service.ticket.update",
      "arguments": {
        "$fact": "trusted_exact_idle_ticket_complete_args"
      },
      "approval_classification": "modifying",
      "approval_required": true,
      "retry": {
        "max_attempts": 1
      },
      "verification_step": "verify_ticket"
    },
    {
      "id": "verify_ticket",
      "type": "verification",
      "capability": "service.ticket.read",
      "arguments": {
        "ticket_id": {
          "$fact": "target_id"
        }
      },
      "next": "ticket_readback_gate"
    },
    {
      "id": "ticket_readback_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_complete_ticket_provider_readback",
            "operator": "eq",
            "value": true
          },
          "next": "complete"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "wait_monitor",
      "type": "wait",
      "seconds": 900,
      "resume": "human_review"
    },
    {
      "id": "complete",
      "type": "complete"
    },
    {
      "id": "human_review",
      "type": "human_review"
    }
  ],
  "trigger": {
    "provider": "Autotask/DRMM",
    "monitor_component_uid": "2b5de042-a3ec-4721-ba66-e0ca193a3604",
    "exact_monitor_and_ticket": true
  },
  "verification": {
    "authoritative_source": "exact current client policy, DRMM monitor UID, approved setter job status/stdout/stderr and Autotask ticket readback",
    "success_condition": "verified compliant current monitor, exact internal note and ticket status, or Human Review; no direct forced logoff"
  }
}
