{
  "autonomy": {
    "activation": "shadow",
    "allowed_capabilities": [
      "automation.component.execute",
      "automation.job.read",
      "backup.backupiq.alert.search",
      "backup.endpoint.asset.read",
      "backup.endpoint.asset.search",
      "backup.endpoint.backup.search",
      "endpoint.device.read",
      "service.ticket.note.create",
      "service.ticket.notes.search",
      "service.ticket.read",
      "service.ticket.update"
    ],
    "approval_bound_branches": [
      "reinstall_agent",
      "create_note",
      "complete_ticket"
    ],
    "disruptive_branches": []
  },
  "completion": {
    "terminal_disposition": "verified recovered backup/ticket Complete or waiting true offline / Human Review"
  },
  "expected_state": {
    "fresh_successful_backup_within_original_threshold": true,
    "exact_provider_asset_and_DRMM_device_verified": true,
    "backup_enabled": true,
    "no_conflicting_duplicate_assets": true
  },
  "migration": {
    "source_conversion": "original_DEB_exact_asset_classifier_and_source_only_json_action_candidate",
    "legacy_source_blob_sha": "9dde241866ddca31f9640d3deb1e0b3ed5a19228",
    "legacy_registry_version": "1.3.0",
    "source_map": "docs/playbooks/json/migration/source_maps/backupiq_endpoint_backup.source-map.json",
    "missing_or_unimplemented_parity": [
      "OpenBao-backed verified backup_net customer-to-Autotask company binding and zero-asset customer proof not yet connected to JSON runtime",
      "Original provider asset, backup success and alert result parser normalization, existing agent components/site variable reads and linked job output not fully wired",
      "Durable one-reinstall job and 1-hour/10-day waiting state and reverse-recheck/readback continuation must be proven",
      "Exact one authorized reinstall and post-install new backup/current alert verification plus ticket note/provider readback not accepted in isolated preproduction",
      "Potential BackupIQ false-positive provider statuses and protected asset exceptions need independent synthetic/live acceptance"
    ],
    "accepted_for_execution": false,
    "production_activation_authorized": false
  },
  "playbook": {
    "id": "backupiq_endpoint_backup",
    "lifecycle": "pilot",
    "name": "Jason - BackupIQ Datto Endpoint Backup",
    "owner": "AOT",
    "source": "docs/playbooks/Jason-BackupIQ-Datto-Endpoint-Backup.md",
    "target_type": "endpoint",
    "version": "1.3.0-migration.2"
  },
  "schema_version": 1,
  "scope": {
    "direct_provider_access": false,
    "no_backup_delete_or_restore": true,
    "no_retention_policy_change": true,
    "company_id_zero_permitted": true,
    "only_one_agent_reinstall_per_incident": true
  },
  "state_model": {
    "entry_step": "read_ticket",
    "persist": [
      "ticket_id",
      "client_id",
      "device_uid",
      "asset_id",
      "provider_customer_id_verified",
      "classification",
      "last_successful_backup",
      "provider_status",
      "evidence_sha256",
      "reinstall_attempted",
      "component_uid",
      "job_uid",
      "job_output_sha",
      "next_recheck_at"
    ],
    "cadence_seconds": 3600,
    "stale_days": 10,
    "no_reinstall_retry_on_uncertain_job": true
  },
  "steps": [
    {
      "id": "read_ticket",
      "type": "diagnostic",
      "capability": "service.ticket.read",
      "arguments": {
        "ticket_id": {
          "$fact": "target_id"
        }
      },
      "next": "ticket_gate"
    },
    {
      "id": "ticket_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_ticket_company_and_device_proven",
            "operator": "eq",
            "value": true
          },
          "next": "read_endpoint"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "read_endpoint",
      "type": "diagnostic",
      "capability": "endpoint.device.read",
      "arguments": {
        "resource_id": {
          "$fact": "device_uid"
        }
      },
      "next": "endpoint_gate"
    },
    {
      "id": "endpoint_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_endpoint_uid_hostname_verified",
            "operator": "eq",
            "value": true
          },
          "next": "provider_customer_gate"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "provider_customer_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "governed_backup_net_same_company_customer_boundary_verified",
            "operator": "eq",
            "value": true
          },
          "next": "read_assets"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "read_assets",
      "type": "diagnostic",
      "capability": "backup.endpoint.asset.search",
      "arguments": {
        "company_id": {
          "$fact": "company_id"
        },
        "name": {
          "$fact": "hostname"
        },
        "page_size": 100
      },
      "next": "read_alerts"
    },
    {
      "id": "read_alerts",
      "type": "diagnostic",
      "capability": "backup.backupiq.alert.search",
      "arguments": {
        "company_id": {
          "$fact": "company_id"
        },
        "asset_name": {
          "$fact": "hostname"
        },
        "page_size": 100
      },
      "next": "read_backups"
    },
    {
      "id": "read_backups",
      "type": "diagnostic",
      "capability": "backup.endpoint.backup.search",
      "arguments": {
        "$fact": "trusted_exact_backup_read_arguments"
      },
      "next": "classification_gate"
    },
    {
      "id": "classification_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "verified_backupiq_disposition",
            "operator": "eq",
            "value": "stale_or_recovered_alert"
          },
          "next": "recovered_gate"
        },
        {
          "when": {
            "fact": "verified_backupiq_disposition",
            "operator": "eq",
            "value": "true_offline_both_sources"
          },
          "next": "wait_device"
        },
        {
          "when": {
            "fact": "verified_backupiq_disposition",
            "operator": "eq",
            "value": "backup_agent_connectivity_failure"
          },
          "next": "reinstall_gate"
        },
        {
          "when": {
            "fact": "verified_backupiq_disposition",
            "operator": "eq",
            "value": "persistent_backupiq_condition_after_success"
          },
          "next": "reinstall_gate"
        },
        {
          "when": {
            "fact": "verified_backupiq_disposition",
            "operator": "eq",
            "value": "backup_failure_or_stale_success"
          },
          "next": "reinstall_gate"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "recovered_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "fresh_backup_and_original_alert_cleared_verified",
            "operator": "eq",
            "value": true
          },
          "next": "note_gate"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "reinstall_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_one_reinstall_component_owner_grant_and_no_prior_attempt",
            "operator": "eq",
            "value": true
          },
          "next": "reinstall_agent"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "reinstall_agent",
      "type": "remediation",
      "capability": "automation.component.execute",
      "arguments": {
        "$fact": "trusted_exact_backupiq_reinstall_component_arguments"
      },
      "approval_classification": "modifying",
      "approval_required": true,
      "retry": {
        "max_attempts": 1
      },
      "verification_step": "verify_job"
    },
    {
      "id": "verify_job",
      "type": "verification",
      "capability": "automation.job.read",
      "arguments": {
        "$fact": "trusted_exact_existing_job_read_arguments"
      },
      "next": "job_gate"
    },
    {
      "id": "job_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "same_device_job_terminal_and_component_completed",
            "operator": "eq",
            "value": true
          },
          "next": "verify_asset"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "verify_asset",
      "type": "verification",
      "capability": "backup.endpoint.asset.read",
      "arguments": {
        "resource_id": {
          "$fact": "asset_id"
        }
      },
      "next": "verify_backups"
    },
    {
      "id": "verify_backups",
      "type": "verification",
      "capability": "backup.endpoint.backup.search",
      "arguments": {
        "$fact": "trusted_exact_backup_read_arguments"
      },
      "next": "backup_success_gate"
    },
    {
      "id": "backup_success_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "fresh_backup_after_remediation_and_no_current_alert",
            "operator": "eq",
            "value": true
          },
          "next": "note_gate"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "note_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_internal_note_and_owner_promotion",
            "operator": "eq",
            "value": true
          },
          "next": "create_note"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "create_note",
      "type": "remediation",
      "capability": "service.ticket.note.create",
      "arguments": {
        "$fact": "trusted_exact_internal_note_arguments"
      },
      "approval_classification": "modifying",
      "approval_required": true,
      "retry": {
        "max_attempts": 1
      },
      "verification_step": "verify_note"
    },
    {
      "id": "verify_note",
      "type": "verification",
      "capability": "service.ticket.notes.search",
      "arguments": {
        "ticket_id": {
          "$fact": "target_id"
        }
      },
      "next": "note_readback_gate"
    },
    {
      "id": "note_readback_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_jason_internal_note_readback",
            "operator": "eq",
            "value": true
          },
          "next": "complete_ticket"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "complete_ticket",
      "type": "remediation",
      "capability": "service.ticket.update",
      "arguments": {
        "$fact": "trusted_exact_complete_ticket_arguments"
      },
      "approval_classification": "modifying",
      "approval_required": true,
      "retry": {
        "max_attempts": 1
      },
      "verification_step": "verify_ticket"
    },
    {
      "id": "verify_ticket",
      "type": "verification",
      "capability": "service.ticket.read",
      "arguments": {
        "ticket_id": {
          "$fact": "target_id"
        }
      },
      "next": "ticket_readback_gate"
    },
    {
      "id": "ticket_readback_gate",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_complete_ticket_provider_readback",
            "operator": "eq",
            "value": true
          },
          "next": "complete"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "wait_device",
      "type": "wait",
      "seconds": 3600,
      "resume": "human_review"
    },
    {
      "id": "complete",
      "type": "complete"
    },
    {
      "id": "human_review",
      "type": "human_review"
    }
  ],
  "trigger": {
    "provider": "Autotask / BackupIQ",
    "title_prefix": "BackupIQ:",
    "exact_same_company_backup_net_customer_boundary": true
  },
  "verification": {
    "authoritative_source": "exact backup_net customer-bound UniView asset, BackupIQ alert, backup success, DRMM endpoint, Autotask note/ticket",
    "success_condition": "fresh successful provider backup, matching asset/client, provider readback and no unresolved alert or duplicate job"
  }
}
