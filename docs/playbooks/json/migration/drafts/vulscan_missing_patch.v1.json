{
  "autonomy": {
    "activation": "shadow",
    "allowed_capabilities": [
      "endpoint.patch.search",
      "service.ticket.search"
    ],
    "approval_bound_branches": [],
    "disruptive_branches": []
  },
  "completion": {
    "terminal_disposition": "source-only candidate; unsupported or unverified branches remain human review, not ticket closure"
  },
  "expected_state": {
    "actual_health_requires_authoritative_provider_readback": true,
    "documented_section": "legacy source section 5"
  },
  "migration": {
    "accepted_for_execution": false,
    "additional_required_compatibility": [
      "trusted provider result-to-fact normalizer for each step",
      "exact capability argument schema and approved source identity",
      "all original documented state transitions, dedup/retries, job polls and provider readbacks",
      "per-playbook legacy-vs-JSON positive/negative/approval/recovery parity",
      "isolated shadow acceptance with actual governed read-port binding"
    ],
    "behavior_branches_mapped": {
      "all_else": "human_review",
      "healthy": "exact_kb_installed_or_superseded",
      "one_approved_action": "approved_patch_stack_repair_warranted",
      "waiting": "waiting_normal_patch_window_or_approval"
    },
    "legacy_registry_version": "1.1.0",
    "legacy_source_blob_sha": "c44b06dabd07b5c6755c16fe8ebd91974cc8f5d6",
    "legacy_source_sha256": "807ed1eeed83ae046b734d2a9568fe533fa512d72959f2fd30580d9f20ca8e23",
    "missing_or_unimplemented_parity": [
      "exact KB approval/window and device-patch identity",
      "multi-device ticket split prerequisite",
      "user impact/reboot approval and bounded WU repair flags",
      "exact KB/build/supersedence and ticket verification",
      "Legacy registry does not authorize the requested mutation; this action is blocked pending separately governed source correction and authority."
    ],
    "production_activation_authorized": false,
    "source_conversion": "structural_partial_not_accepted",
    "source_map": "docs/playbooks/json/migration/source_maps/vulscan_missing_patch.source-map.json"
  },
  "playbook": {
    "id": "vulscan_missing_patch",
    "lifecycle": "pilot",
    "name": "Jason - Windows Update VulScan Missing Patch",
    "owner": "AOT",
    "source": "docs/playbooks/Jason-Windows-Update-VulScan-Missing-Patch.md",
    "target_type": "ticket",
    "version": "1.1.0-migration.1"
  },
  "schema_version": 1,
  "scope": {
    "any_unsupported_branch": "human_review",
    "direct_provider_access": false,
    "no_production_activation": true,
    "source_only": true
  },
  "state_model": {
    "entry_step": "read_target",
    "legacy_wait_retry_semantics": "UNMAPPED_BLOCKING",
    "must_resume_without_mutation_replay": true
  },
  "steps": [
    {
      "arguments": {
        "page_size": 2,
        "resource_id": {
          "$fact": "ticket_id"
        }
      },
      "capability": "service.ticket.search",
      "id": "read_target",
      "next": "scope_gate",
      "type": "diagnostic"
    },
    {
      "branches": [
        {
          "next": "read_diagnostic",
          "when": {
            "fact": "authoritative_same_client_scope_proven",
            "operator": "eq",
            "value": true
          }
        }
      ],
      "default": "human_review",
      "id": "scope_gate",
      "type": "decision"
    },
    {
      "arguments": {
        "$fact": "server_verified_diagnostic_read_arguments"
      },
      "capability": "endpoint.patch.search",
      "id": "read_diagnostic",
      "next": "classification_gate",
      "type": "diagnostic"
    },
    {
      "branches": [
        {
          "next": "verified_no_action_gate",
          "when": {
            "fact": "verified_legacy_disposition",
            "operator": "eq",
            "value": "exact_kb_installed_or_superseded"
          }
        },
        {
          "next": "human_review",
          "when": {
            "fact": "verified_legacy_disposition",
            "operator": "eq",
            "value": "approved_patch_stack_repair_warranted"
          }
        },
        {
          "next": "wait_for_source",
          "when": {
            "fact": "verified_legacy_disposition",
            "operator": "eq",
            "value": "waiting_normal_patch_window_or_approval"
          }
        }
      ],
      "default": "human_review",
      "id": "classification_gate",
      "type": "decision"
    },
    {
      "branches": [
        {
          "next": "read_only_complete",
          "when": {
            "fact": "authoritative_healthy_state_proven",
            "operator": "eq",
            "value": true
          }
        }
      ],
      "default": "human_review",
      "id": "verified_no_action_gate",
      "type": "decision"
    },
    {
      "id": "read_only_complete",
      "type": "complete"
    },
    {
      "id": "wait_for_source",
      "resume": "bounded_wait_terminal",
      "seconds": 3600,
      "type": "wait"
    },
    {
      "id": "bounded_wait_terminal",
      "type": "human_review"
    },
    {
      "id": "human_review",
      "type": "human_review"
    }
  ],
  "trigger": {
    "legacy_registry_entry": "vulscan_missing_patch",
    "runtime_filter_integration": "NOT_COMPLETE",
    "source_version": "1.1.0"
  },
  "verification": {
    "authoritative_source": "endpoint.patch.search",
    "success_condition": "exact same-client healthy state independently proven; all writes separately authorized and read back"
  }
}
