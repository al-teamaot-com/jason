{
  "schema_version": 1,
  "playbook": {
    "id": "windows_time_source",
    "name": "Jason - Windows Time Source Self-Heal (classification preview)",
    "version": "0.1.1-jsonpreview",
    "lifecycle": "pilot",
    "target_type": "provider_object",
    "owner": "AOT IT Operations",
    "source": "docs/playbooks/Jason-Windows-Time-Source-Self-Heal.md",
    "migration_status": "design_preview_no_parity_no_staging"
  },
  "trigger": {
    "provider": "datto_rmm",
    "match": {
      "alert_context_class": "comp_script_ctx",
      "diagnostic_contains": [
        "Time source mismatch.",
        "not in approved list:"
      ]
    }
  },
  "scope": {
    "direct_provider_access": false,
    "read_only_classification_preview": true,
    "no_endpoint_modification": true,
    "no_alert_resolution": true,
    "no_ticket_mutation": true
  },
  "expected_state": {
    "domain_member": "source authorized by exact client/site policy, Windows Time synchronized, exact triggering alert resolved",
    "non_domain": "approved site policy must be explicitly provided; never guess NTP servers"
  },
  "state_model": {
    "entry_step": "preconditions",
    "external_evidence_required": [
      "identity_verified",
      "endpoint_online",
      "is_domain_controller",
      "trust_or_dc_discovery_problem",
      "policy_conflict",
      "recurrence_threshold_met",
      "time_source_approved",
      "needs_resync",
      "wrong_sync_mode",
      "exact_alert_resolved"
    ],
    "no_live_recheck_scheduler": true
  },
  "steps": [
    {
      "id": "preconditions",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "identity_verified",
            "operator": "falsy"
          },
          "next": "human_review"
        },
        {
          "when": {
            "fact": "endpoint_online",
            "operator": "falsy"
          },
          "next": "wait_for_endpoint"
        },
        {
          "when": {
            "fact": "is_domain_controller",
            "operator": "truthy"
          },
          "next": "human_review"
        },
        {
          "when": {
            "fact": "trust_or_dc_discovery_problem",
            "operator": "truthy"
          },
          "next": "human_review"
        },
        {
          "when": {
            "fact": "policy_conflict",
            "operator": "truthy"
          },
          "next": "human_review"
        },
        {
          "when": {
            "fact": "recurrence_threshold_met",
            "operator": "truthy"
          },
          "next": "human_review"
        }
      ],
      "default": "source_classification"
    },
    {
      "id": "wait_for_endpoint",
      "type": "wait",
      "seconds": 900,
      "resume": "wait_followup_review",
      "wake_condition_note": "Acyclic v1 preview cannot model repeated device polling; operational worker retains scheduling authority."
    },
    {
      "id": "wait_followup_review",
      "type": "human_review"
    },
    {
      "id": "source_classification",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "time_source_approved",
            "operator": "truthy"
          },
          "next": "verify_evidence"
        },
        {
          "when": {
            "fact": "needs_resync",
            "operator": "truthy"
          },
          "next": "approval_required"
        },
        {
          "when": {
            "fact": "wrong_sync_mode",
            "operator": "truthy"
          },
          "next": "approval_required"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "verify_evidence",
      "type": "decision",
      "branches": [
        {
          "when": {
            "fact": "exact_alert_resolved",
            "operator": "truthy"
          },
          "next": "shadow_healthy"
        }
      ],
      "default": "human_review"
    },
    {
      "id": "approval_required",
      "type": "human_review"
    },
    {
      "id": "human_review",
      "type": "human_review"
    },
    {
      "id": "shadow_healthy",
      "type": "complete"
    }
  ],
  "verification": {
    "authoritative_source": "Governed Windows Time diagnostics and exact DRMM alert; no verification performed by this preview",
    "success_condition": "Fresh diagnostic confirms approved time source/synchronization and exact alert no longer open; all evidence bound to correct endpoint"
  },
  "completion": {
    "terminal_disposition": "PREVIEW_ONLY_NO_TICKET_OR_ALERT_STATE_CHANGE"
  },
  "autonomy": {
    "activation": "disabled",
    "allowed_capabilities": []
  },
  "migration": {
    "preview_only": true,
    "not_staged": true,
    "not_activated": true,
    "parity": "classification-only; NOT an accepted replacement for the current Markdown playbook",
    "missing": [
      "Governed exact endpoint/alert data-to-fact binding",
      "read-only Windows Time diagnostic evidence and authoritative parsing",
      "validated durable waiting/rechecks without JSON graph loops",
      "approved, explicit and bounded remediation capability branches",
      "independent alert and ticket verification",
      "worker-to-interpreter integration and full regression/shadow acceptance"
    ],
    "rule": "Never stage or activate this design artifact until accepted capabilities, exact selectors, source parity, interpreter integration, and controlled shadow tests are demonstrated."
  }
}
